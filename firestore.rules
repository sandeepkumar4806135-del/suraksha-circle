rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helpers (MVP: any signed-in user; tighten to per-member checks once
    // auth roles / membership claims land).
    // ------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    // Schedule shape shared by create + update.
    function isValidSchedule() {
      return request.resource.data.kind in ['medication', 'appointment']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 200
        && request.resource.data.elderName is string
        && request.resource.data.elderName.size() > 0
        && request.resource.data.time is string
        && request.resource.data.time.matches('^[0-9]{2}:[0-9]{2}$');
    }

    // Safe-zone shape for creates.
    function isValidZone() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 200
        && request.resource.data.lat is number
        && request.resource.data.lat >= -90
        && request.resource.data.lat <= 90
        && request.resource.data.lng is number
        && request.resource.data.lng >= -180
        && request.resource.data.lng <= 180
        && request.resource.data.radiusM is number
        && request.resource.data.radiusM >= 50
        && request.resource.data.radiusM <= 2000;
    }

    // True when the caller already belongs to the circle's members map.
    // Rules-side reads (get/exists) bypass client read rules, so this can
    // safely gate reads on collections that are themselves member-only.
    function memberOf(circleId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/circles/$(circleId))
        && get(/databases/$(database)/documents/circles/$(circleId)).data.members.get(request.auth.uid, null) != null;
    }

    // Circle metadata document (one per family circle).
    // Read: members only — the doc holds the members map (names + phone
    // numbers), so circle ids are never a public lookup table. Joiners resolve
    // invite codes through circleInvites/{code} instead.
    // Created only by lib/circle-membership: requires a 6-char inviteCode
    // (immutable afterwards) and the uid-keyed members map.
    match /circles/{circleId} {
      allow read: if memberOf(circleId);
      allow create: if isSignedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 120
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 6
        && request.resource.data.members is map
        && request.resource.data.members.keys().hasOnly([request.auth.uid]);
      // Updates may only ever touch the caller's OWN member entry: nobody can
      // rewrite another member's name/status/check-in, remove anyone, rename
      // the circle or rotate its invite code. Joining still works because a
      // new member only adds their own uid key.
      allow update: if isSignedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 120
        && request.resource.data.get('inviteCode', null) == resource.data.get('inviteCode', null)
        && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
        && request.resource.data.members is map
        && request.resource.data.members.size() >= resource.data.members.size()
        && request.resource.data.members.diff(resource.data.members).removedKeys().size() == 0
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]);
      allow delete: if false;
    }

    // Invite-code lookup: `circleInvites/{CODE} -> { circleId, circleName }`.
    // The code is the secret: any signed-in user who was handed one may read
    // the lookup so they can join without read access to circles they are not
    // in yet. Codes are immutable and can never be re-pointed at another circle.
    match /circleInvites/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && code.size() == 6
        && request.resource.data.keys().hasAll(['circleId', 'circleName', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.circleId is string
        && request.resource.data.circleId.size() > 0
        && request.resource.data.circleName is string
        && request.resource.data.circleName.size() > 0
        && request.resource.data.circleName.size() < 120
        // Reserved either for a circle that does not exist yet (the creator's
        // own flow writes the code before the circle) or for a circle the
        // caller already belongs to.
        && (!exists(/databases/$(database)/documents/circles/$(request.resource.data.circleId))
            || memberOf(request.resource.data.circleId));
      allow update, delete: if false;
    }

    // Pending invitations: people added by name before they have an account.
    // Members manage them; the invitee shows as "Invite pending" on the
    // dashboard until they join with a code.
    match /circles/{circleId}/invites/{inviteId} {
      allow read, delete: if memberOf(circleId);
      allow create: if memberOf(circleId)
        && request.resource.data.keys().hasAll(['name', 'addedBy'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 100
        && request.resource.data.addedBy == request.auth.uid
        && (request.resource.data.role == null || request.resource.data.role is string)
        && (request.resource.data.city == null || request.resource.data.city is string);
      allow update: if false;
    }

    // Activity feed: events live under each circle, append-only.
    match /circles/{circleId}/events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['type', 'actorName', 'title'])
        && request.resource.data.type is string
        && request.resource.data.actorName is string
        && request.resource.data.title is string
        && request.resource.data.title.size() < 200;
      allow update, delete: if false; // events are append-only
    }

    // Activity trail: audit log lives under each circle, append-only.
    match /circles/{circleId}/activityLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['type', 'userId', 'userName', 'message'])
        && request.resource.data.type in ['check_in', 'check_in_nudge', 'sos_triggered', 'sos_resolved', 'location_started', 'location_stopped', 'place_marked']
        && request.resource.data.userId is string
        && request.resource.data.userName is string
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 300;
      allow update, delete: if false; // audit trail is append-only
    }

    // Safe zones: circles/{circleId}/safezones/{zoneId}.
    // Create + delete only (no in-app edit path today); validated shape.
    match /circles/{circleId}/safezones/{zoneId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['name', 'emoji', 'lat', 'lng', 'radiusM'])
        && isValidZone();
      allow update: if false; // no edit path in safe-zones.ts (create + delete only)
      allow delete: if isSignedIn();
    }

    // Caretaker / doctor access grants: circles/{circleId}/caretaker_access.
    // Signed-in family members manage grants (create/revoke). External
    // caretaker sessions are strictly READ-ONLY elsewhere in these rules —
    // no rule here (or below) ever grants an external visitor a write path
    // to sos_events, schedules, safezones or events.
    match /circles/{circleId}/caretaker_access/{grantId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['role', 'codeHash', 'visitorName'])
        && request.resource.data.role in ['doctor', 'caretaker', 'family-admin']
        && request.resource.data.codeHash is string
        && request.resource.data.codeHash.size() == 64
        && request.resource.data.visitorName is string
        && request.resource.data.visitorName.size() > 0
        && request.resource.data.visitorName.size() < 120;
      // Only the revoked flag may change after creation — codes can never be
      // silently re-targeted at another role or circle.
      allow update: if isSignedIn()
        && request.resource.data.role == resource.data.role
        && request.resource.data.codeHash == resource.data.codeHash;
      allow delete: if isSignedIn(); // hard-remove on cleanup
    }

    // FCM Web Push device tokens: circles/{circleId}/push_tokens/{tokenId}.
    // Any signed-in member may register their device (create/update) or
    // deregister it (delete). Token docs are never read from the client —
    // the server lists them via Firestore REST with admin credentials.
    match /circles/{circleId}/push_tokens/{tokenId} {
      allow read: if false; // client never needs to read tokens back
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasAll(['token', 'memberName', 'platform'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() < 512
        && request.resource.data.memberName is string
        && request.resource.data.memberName.size() > 0
        && request.resource.data.memberName.size() < 120
        && request.resource.data.platform is string;
      allow delete: if isSignedIn();
    }

    // Smart schedule / medication reminders: circles/{circleId}/schedules.
    // Identity fields (kind, createdAt) are immutable; status toggles
    // pending <-> taken with a paired takenAt invariant.
    match /circles/{circleId}/schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['kind', 'name', 'time', 'elderName'])
        && isValidSchedule();
      allow update: if isSignedIn()
        && request.resource.data.status in ['pending', 'taken']
        && (request.resource.data.status == 'taken') == (request.resource.data.takenAt != null)
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidSchedule();
      allow delete: if isSignedIn();
    }

    // SOS emergency cascade — must be writable instantly by any signed-in
    // member; resolution is also allowed (banner resolve flow).
    // circleId + createdAt are immutable so an SOS can never be retargeted
    // to another circle. Resolved alerts are kept (delete: false).
    match /sos_events/{sosId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['circleId', 'raisedBy', 'raisedByName', 'status'])
        && request.resource.data.status == 'active'
        && request.resource.data.circleId is string
        && request.resource.data.circleId.size() > 0;
      allow update: if isSignedIn()
        && request.resource.data.status in ['active', 'resolved']
        && request.resource.data.circleId == resource.data.circleId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false; // keep the audit trail
    }

    // User profile: one per signed-in account (phone, name, active circle).
    // Owner-only reads/updates so no one else can see your number or follow
    // your circle; creation is shape-validated (lib/user-profile).
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['phone', 'displayName', 'circleId', 'createdAt'])
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() < 40
        && (request.resource.data.displayName == null
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() < 100))
        && (request.resource.data.circleId == null
            || request.resource.data.circleId is string);
      // Updates may only ever point circleId at a circle the user really
      // belongs to (or clear it) — a tampered id cannot fake membership.
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.phone is string
        && (request.resource.data.displayName == null
            || request.resource.data.displayName is string)
        && (request.resource.data.circleId == resource.data.get('circleId', null)
            || request.resource.data.circleId == null
            || (request.resource.data.circleId is string
                && memberOf(request.resource.data.circleId)));
      allow delete: if false;
    }

    // Firestore: beta feedback collection (append-only, shape-validated).
    match /betaFeedback/{feedbackId} {
      allow read: if false; // reviewed via console / admin only
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['userId', 'userName', 'category', 'message'])
        && request.resource.data.category in ['bug', 'feature', 'general']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() < 1000;
      allow update, delete: if false;
    }

    // Defense in depth: default is deny; this makes it explicit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
